world/**/session.lock
world/**/level.dat_old
world/**/logs/
world/**/crash-reports/
logs/
crash-reports/
*.log

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- 本机专属配置 ----
